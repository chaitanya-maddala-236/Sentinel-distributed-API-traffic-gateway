FROM python:3.12-slim AS base
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app
COPY pyproject.toml /app/pyproject.toml
RUN pip install --no-cache-dir \
    fastapi uvicorn[standard] sqlalchemy asyncpg alembic pydantic pydantic-settings \
    passlib[bcrypt] python-jose[cryptography] redis orjson structlog
COPY apps/control_plane /app/apps/control_plane
COPY apps/__init__.py /app/apps/__init__.py
COPY packages /app/packages
EXPOSE 8001
CMD ["uvicorn", "apps.control_plane.main:app", "--host", "0.0.0.0", "--port", "8001"]
